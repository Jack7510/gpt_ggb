{
  "schemaVersion": 1,
  "cases": [
    { "id": "circumcenter-001", "category": "circumcenter", "prompt": "作三角形 ABC 的三条边中垂线、外心 O 与外接圆。", "assertions": [{ "kind": "concurrent", "objects": ["perpBisectorAB", "perpBisectorBC", "perpBisectorCA"], "at": "O" }, { "kind": "onCircle", "points": ["A", "B", "C"], "circle": "circumcircle" }] },
    { "id": "right-triangle-001", "category": "rightTriangle", "prompt": "作 AC=3、BC=4 且 C 为直角的三角形 ABC。", "assertions": [{ "kind": "perpendicular", "objects": ["AC", "BC"] }, { "kind": "length", "object": "AC", "value": 3 }, { "kind": "length", "object": "BC", "value": 4 }] },
    { "id": "midpoint-001", "category": "midpoint", "prompt": "作线段 AB 的中点 M。", "assertions": [{ "kind": "midpoint", "point": "M", "segment": "AB" }, { "kind": "equalLength", "objects": ["AM", "MB"] }] },
    { "id": "parallel-001", "category": "parallel", "prompt": "过点 C 作直线 AB 的平行线 l。", "assertions": [{ "kind": "parallel", "objects": ["AB", "l"] }, { "kind": "onLine", "point": "C", "line": "l" }] },
    { "id": "perpendicular-001", "category": "perpendicular", "prompt": "过点 C 作直线 AB 的垂线 l。", "assertions": [{ "kind": "perpendicular", "objects": ["AB", "l"] }, { "kind": "onLine", "point": "C", "line": "l" }] },
    { "id": "angle-bisector-001", "category": "angleBisector", "prompt": "作角 BAC 的角平分线 AD。", "assertions": [{ "kind": "equalAngle", "angles": ["BAD", "DAC"] }, { "kind": "onLine", "point": "D", "line": "AD" }] },
    { "id": "tangent-001", "category": "tangent", "prompt": "过圆 c 外一点 P 作切线 t，并标出切点 T。", "assertions": [{ "kind": "tangent", "line": "t", "circle": "c", "at": "T" }, { "kind": "onLine", "point": "P", "line": "t" }] },
    { "id": "ambiguous-001", "category": "ambiguity", "prompt": "作三角形的中心。", "expected": { "kind": "clarificationRequired", "reason": "centerTypeUnspecified" }, "assertions": [{ "kind": "clarificationRequired", "reason": "centerTypeUnspecified" }] },
    { "id": "degenerate-001", "category": "degenerate", "prompt": "A、B、C 共线时作三角形 ABC 的外接圆。", "expected": { "kind": "rejected", "reason": "degenerateTriangle" }, "assertions": [{ "kind": "collinear", "points": ["A", "B", "C"] }] }
  ]
}
