{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": "lib/.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/main.ts",
    "src/app/App.vue"
  ],
  "references": [
    {
      "path": "../../packages/application"
    },
    {
      "path": "../../packages/geometry-geogebra"
    }
  ]
}
