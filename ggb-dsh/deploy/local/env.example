# Deployment environment for the plugin-core Server. Copy to `.env` and fill in real
# values; never commit the filled file. Every `*_SECRET`/`*_PEPPER` value must be 64
# lowercase hex characters (32 random bytes) and can be supplied as `<NAME>_FILE`
# instead of a plain value, which is how the container image injects them (§7.5, §12).

# --- shared by apps/api and apps/worker -------------------------------------------
# dev.sh supplies a shared local SQLite path when this is empty. Production requires PostgreSQL.
GGB_V3_DATABASE_URL=
# Set to 1 to let the processes apply migrations at boot; the explicit one-shot job
# `deploy/migrations/apply.mjs` is preferred for releases (§15). Only
# 017_plugin_core.sql is applied; earlier files remain as migration history.
GGB_V3_AUTO_MIGRATE=0
GGB_V3_MIGRATIONS_DIR=packages/run-persistence/migrations
GGB_V3_WORKER_SOCKET_PATH=/run/ggb/worker.sock
GGB_V3_WORKER_SECRET_FILE=/run/ggb/worker-secret

# --- apps/api ---------------------------------------------------------------------
PORT=8080
GGB_V3_LISTEN_HOST=0.0.0.0
GGB_V3_SERVER_PEPPER_FILE=/run/ggb/server-pepper
GGB_V3_MAX_BODY_BYTES=41943040
# Strict same-origin CORS (§12); empty disables the check for local development only.
GGB_V3_ALLOWED_ORIGIN=
# Built Client PWA shell served by the API; empty disables static serving entirely
# (local development uses the Vite dev server instead).
GGB_V3_CLIENT_DIST_DIR=/app/apps/client/dist
# Defaults to `<client-dist>/geogebra`; the runtime is validated against the pinned
# release at boot and an incomplete or mismatched runtime fails startup (§10, §11).
GGB_V3_GEOGEBRA_ROOT=/app/apps/client/dist/geogebra
GGB_V3_RUNTIME_VERSIONS_PATH=/app/config/runtime-versions.json
GGB_V3_TTL_ACTIVE_RUN_MS=86400000
GGB_V3_TTL_TERMINAL_RUN_MS=604800000
GGB_V3_TTL_ARTIFACT_MS=2592000000
# §15 release/scale-down: on SIGTERM admission stops, then the process waits this long
# for in-flight requests before closing. `0` disables the window.
GGB_V3_DRAIN_GRACE_MS=15000

# --- construction engine ----------------------------------------------------------
# plugin-core is the only engine.
GGB_AGENT_ENGINE=plugin_core
# The plugin runtime is provisioned from the vendored TGZ by
# tools/provision-plugin-core.mjs and verified at Worker startup.
# GGB_PLUGIN_ROOT=/app/plugin-core
# GGB_PLUGIN_CORE_OUTPUT_ROOT=/var/lib/ggb-dsh/plugin-core-runs
# GGB_PLUGIN_CORE_MAX_CONCURRENT_RUNS=1
# PLAYWRIGHT_BROWSERS_PATH=/app/ms-playwright

# --- apps/worker ------------------------------------------------------------------
GGB_V3_WORKER_DRAIN_MS=15000
GGB_V3_DSH_WORKSPACE_ROOT=/app
GGB_V3_DSH_HOME_ROOT=/dsh-home
# Debug only, unset by default. When set, every model request and raw answer is written under
# <root>/<runId>/, and per-run DSH homes are kept instead of deleted in `finally`. Trace files hold
# task data and model output; the Provider credential is never written. Do not enable in production.
# GGB_V3_DSH_TRACE_ROOT=
# Provider origin is server-owned and pinned (§7.2); the Client can never override it.
GGB_V3_PROVIDER_BASE_URL=https://api.deepseek.com/anthropic
