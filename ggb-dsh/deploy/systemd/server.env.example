# Abstract production configuration. Copy to /etc/ggb-dsh/server.env and set
# permissions to 0600. Keep all secret material in the referenced files.
NODE_ENV=production
PORT=8080
GGB_V3_DATABASE_URL=postgresql:///ggb_dsh?host=/var/run/postgresql
GGB_V3_AUTO_MIGRATE=0
GGB_V3_MIGRATIONS_DIR=packages/run-persistence/migrations
GGB_V3_WORKER_SOCKET_PATH=/run/ggb-dsh/worker.sock
GGB_V3_WORKER_SECRET_FILE=/etc/ggb-dsh/secrets/worker-secret
GGB_V3_SERVER_PEPPER_FILE=/etc/ggb-dsh/secrets/server-pepper
GGB_V3_MAX_BODY_BYTES=41943040
GGB_V3_ALLOWED_ORIGIN=https://ggb-app.cpolar.cn
GGB_V3_ALLOWED_HOSTS=ggb-app.cpolar.cn
GGB_V3_CLIENT_DIST_DIR=/home/admin/work/ggb-dsh/ggb_copilot/ggb-dsh/apps/client/dist
GGB_V3_GEOGEBRA_ROOT=/home/admin/work/ggb-dsh/ggb_copilot/ggb-dsh/apps/client/dist/geogebra
GGB_V3_RUNTIME_VERSIONS_PATH=/home/admin/work/ggb-dsh/ggb_copilot/ggb-dsh/config/runtime-versions.json
GGB_V3_TTL_ACTIVE_RUN_MS=86400000
GGB_V3_TTL_TERMINAL_RUN_MS=604800000
GGB_V3_TTL_ARTIFACT_MS=2592000000
GGB_V3_DRAIN_GRACE_MS=15000
GGB_V3_JANITOR_INTERVAL_MS=60000
GGB_V3_JANITOR_BATCH_SIZE=200
GGB_V3_WORKER_DRAIN_MS=15000
GGB_V3_DSH_WORKSPACE_ROOT=/home/admin/work/ggb-dsh/ggb_copilot/ggb-dsh
GGB_V3_DSH_HOME_ROOT=/run/ggb-dsh/dsh-home

# --- plugin-core construction engine ----------------------------------------------
GGB_AGENT_ENGINE=plugin_core
GGB_PLUGIN_ROOT=/opt/ggb-plugin
GGB_PLUGIN_CORE_OUTPUT_ROOT=/run/ggb-dsh/plugin-core-runs
GGB_PLUGIN_CORE_MAX_CONCURRENT_RUNS=1
PLAYWRIGHT_BROWSERS_PATH=/opt/ggb-plugin/ms-playwright
HOME=/run/ggb-dsh/home
XDG_CACHE_HOME=/run/ggb-dsh/cache
TMPDIR=/run/ggb-dsh/tmp
# Debug only, unset by default. See deploy/local/env.example for the retention and data-boundary notes.
# GGB_V3_DSH_TRACE_ROOT=
GGB_V3_PROVIDER_BASE_URL=https://api.deepseek.com/anthropic
